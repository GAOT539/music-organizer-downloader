# =============================================================================
# Sello de Gato Music — Variables de entorno
# =============================================================================
# Copia este archivo como ".env" y ajusta el valor según tu sistema operativo.
#
#   cp .env.example .env          (Linux / macOS)
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# ⚠ NUNCA subas el archivo .env a Git. Está incluido en .gitignore.
# =============================================================================

# Ruta absoluta de la carpeta donde se guardarán las descargas de música.
# Las canciones se organizarán dentro en subcarpetas por artista.

# --- Windows ---
HOST_DOWNLOAD_DIR=C:\Users\TuUsuario\Downloads

# --- Linux / macOS (comenta la línea de Windows y descomenta esta) ---
# HOST_DOWNLOAD_DIR=/home/tuusuario/Downloads
# HOST_DOWNLOAD_DIR=~/Downloads
